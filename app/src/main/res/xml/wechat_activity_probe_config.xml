<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-only

    Diagnostic-only configuration for WeChatCallActivityProbe.

    Only interested in typeWindowStateChanged (fires when the foreground Activity/window
    changes), which is what we need to find out when WeChat's call Activity actually appears,
    relative to when its call notification appears. Does NOT request
    flagRetrieveInteractiveWindows or canRetrieveWindowContent (unlike the earlier, now-removed
    WeChatCallAccessibilityService), this one isn't trying to read anything on screen (that was
    already confirmed blocked by FLAG_SECURE), only the class name reported directly on the event
    itself, which is a much more basic piece of information.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:packageNames="com.tencent.mm" />
